{
  "compilers": [
    {
      "id": "dotnet-sdk",
      "name": ".NET SDK",
      "type": "compiler",
      "author": "Microsoft",
      "description": "The .NET SDK - C#/F#/VB compilers, MSBuild, and the dotnet CLI.",
      "iconUrl": "https://cdn.simpleicons.org/dotnet",
      "fileExtensions": [".cs", ".csproj", ".sln", ".fs", ".fsproj", ".vb", ".vbproj", ".razor", ".cshtml"],
      "languageExtensions": ["csharp-kodo-extension"],
      "run": "dotnet run",
      "build": "dotnet build",
      "resolver": {
        "kind": "text-pointer",
        "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{channel}/latest.version",
        "channel": "8.0",
        "urlTemplate": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-win-x64.exe",
        "fileNameTemplate": "dotnet-sdk-{version}-win-x64.exe"
      },
      "fallback": {
        "version": "8.0.404",
        "downloadUrl": "https://builds.dotnet.microsoft.com/dotnet/Sdk/8.0.404/dotnet-sdk-8.0.404-win-x64.exe",
        "fileName": "dotnet-sdk-8.0.404-win-x64.exe"
      }
    },
    {
      "id": "go",
      "name": "Go",
      "type": "compiler",
      "author": "Google",
      "description": "The Go programming language compiler and tools.",
      "iconUrl": "https://cdn.simpleicons.org/go",
      "fileExtensions": [".go"],
      "run": "go run .",
      "build": "go build .",
      "resolver": {
        "kind": "json-lookup",
        "url": "https://go.dev/dl/?mode=json",
        "filters": "stable=true",
        "versionField": "version",
        "versionStripPrefix": "go",
        "subPath": "files",
        "subFilters": "os=windows;arch=amd64;kind=installer",
        "fileNameField": "filename",
        "urlTemplate": "https://go.dev/dl/{field:filename}"
      },
      "fallback": {
        "version": "1.23.4",
        "downloadUrl": "https://go.dev/dl/go1.23.4.windows-amd64.msi",
        "fileName": "go1.23.4.windows-amd64.msi"
      }
    },
